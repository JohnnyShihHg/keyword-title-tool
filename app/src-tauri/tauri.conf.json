{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeywordTitleTool",
  "version": "0.6.6",
  "identifier": "tw.ebc.keyword-title-tool",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "關鍵標題整理工具",
        "width": 1200,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "TradChinese",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/JohnnyShihHg/keyword-title-tool/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3Q0M1OUE1MzM3RTNGRjIKUldUeVAzNHpwVm5NMXc3ZGN0N25aYXhPNmFzclJ2WkcyUEFXUThpUWMyd2hoN1l2N201S3JOZEsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
